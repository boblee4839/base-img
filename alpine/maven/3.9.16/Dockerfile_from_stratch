FROM alpine:3.24

ENV JAVA_HOME=/opt/java/openjdk
ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en' LC_ALL='en_US.UTF-8'
ENV UID=1010 USER=appuser
ENV MAVEN_HOME=/opt/maven \
    MAVEN_VERSION=3.9.16
ENV PATH="${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${PATH}"

RUN adduser -D -u $UID -s /bin/sh $USER && \
    mkdir -p /home/$USER && \
    chown -R $USER:$USER /home/$USER

RUN set -eux; \
    apk add --no-cache \
        fontconfig ttf-dejavu \
        gnupg p11-kit-trust musl-locales musl-locales-lang ca-certificates tzdata bash coreutils curl yq openssl busybox-extras
RUN set -eux; \
    ARCH="$(apk --print-arch)"; \
    case "${ARCH}" in \
       x86_64) \
         ESUM='073a48cb87f788a0cb283d81cc6d96cbc9d671d6a60a3ba6de62e66f0ea9dd47'; \
         BINARY_URL='https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jdk_x64_alpine-linux_hotspot_21.0.12_8.tar.gz'; \
         ;; \
       *) \
         echo "Unsupported arch: ${ARCH}"; \
         exit 1; \
         ;; \
    esac; \
    wget -O /tmp/openjdk.tar.gz ${BINARY_URL}; \
    wget -O /tmp/openjdk.tar.gz.sig ${BINARY_URL}.sig; \
    export GNUPGHOME="$(mktemp -d)"; \
    gpg --batch --keyserver keyserver.ubuntu.com --recv-keys 3B04D753C9050D9A5D343F39843C48A565F8F04B; \
    gpg --batch --verify /tmp/openjdk.tar.gz.sig /tmp/openjdk.tar.gz; \
    rm -rf "${GNUPGHOME}" /tmp/openjdk.tar.gz.sig; \
    echo "${ESUM} */tmp/openjdk.tar.gz" | sha256sum -c -; \
    mkdir -p "$JAVA_HOME"; \
    tar --extract \
        --file /tmp/openjdk.tar.gz \
        --directory "$JAVA_HOME" \
        --strip-components 1 \
        --no-same-owner \
    ; \
    rm -rf /tmp/openjdk.tar.gz ${JAVA_HOME}/lib/src.zip ${JAVA_HOME}/demo ${JAVA_HOME}/man ${JAVA_HOME}/sample ${JAVA_HOME}/legal;

RUN set -eux; \
    echo "Verifying install ..."; \
    echo "java --version"; java --version; \
    echo "Complete."
COPY --chmod=775 entrypoint.sh /__cacert_entrypoint.sh

ARG MAVEN_DOWNLOAD_SHA512="831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6"
RUN set -eux; \
    wget --no-verbose -O maven.tar.gz \
      "https://dlcdn.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz"; \
    echo "${MAVEN_DOWNLOAD_SHA512}  maven.tar.gz" | sha512sum -c -; \
    mkdir -p "${MAVEN_HOME}"; \
    tar -xzf maven.tar.gz -C "${MAVEN_HOME}" --strip-components=1; \
    rm maven.tar.gz
RUN set -eux; \
    apk update && apk upgrade && \
    apk del --no-cache gnupg wget tar && update-ca-certificates && \
    ln -sf /bin/false /usr/bin/wget && \
    ln -sf /bin/false /usr/bin/tar && \
    rm -rf /var/cache/apk/*
RUN mkdir -p /home/appuser/.m2 && \
    chown appuser:appuser /home/appuser/.m2 && \
    chmod 700 /home/appuser && \
    chmod 700 /home/appuser/.m2
VOLUME /home/appuser/.m2

ENTRYPOINT ["/__cacert_entrypoint.sh"]
USER 1010
CMD ["mvn"]